services:
  db:
    image: postgres:16
    container_name: capelania_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: capelania
      POSTGRES_PASSWORD: capelania
      POSTGRES_DB: capelania
    ports:
      - "5432:5432"
    volumes:
      - capelania_db_data:/var/lib/postgresql/data
      - ./init.sql:/docker-entrypoint-initdb.d/init.sql

volumes:
  capelania_db_data:


  .vscode
  {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/.venv/lib/python3.14/site-packages"
    ]
}